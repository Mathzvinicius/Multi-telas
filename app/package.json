{
  "name": "monitoramento-app",
  "version": "1.0.0",
  "description": "App de monitoramento transparente com indicador de transmissao",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "electron . --dev",
    "server": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run electron-dev\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "screenshot-desktop": "^1.15.0",
    "active-win": "^7.7.2",
    "systeminformation": "^5.21.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2"
  },
  "build": {
    "appId": "com.empresa.monitoramento",
    "productName": "Monitoramento",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
